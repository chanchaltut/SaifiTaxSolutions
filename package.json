{
  "name": "saifi-tax-solutions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Saifi Tax Solutions website. React, prerendered to static HTML for search and answer engines.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview --outDir dist/site --port 4173",
    "verify": "node scripts/verify.mjs",
    "og": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "node-html-markdown": "^2.0.0",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.6"
  }
}
