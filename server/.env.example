# ─────────────────────────────────────────────────────────────
# Saifi website management API. Copy this file to ".env" and fill it in.
# Never commit .env: it holds passwords.
# On Render/Railway, enter the same names in the dashboard instead.
# ─────────────────────────────────────────────────────────────

# development on your computer, production on the live server
NODE_ENV=development
PORT=4000

# MongoDB Atlas → your cluster → Connect → Drivers → copy the string.
# Replace <password> and put the database name (saifi) before the "?".
MONGODB_URI=mongodb+srv://saifi-admin:<password>@cluster0.xxxxx.mongodb.net/saifi?retryWrites=true&w=majority

# A long random secret that signs sign-in sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How many days someone stays signed in
SESSION_DAYS=7

# The public website (allowed to use this API). No slash at the end.
CLIENT_URL=http://localhost:5173
# Other addresses that may use the API, comma separated (e.g. the www domain, Vercel preview URLs)
CORS_ORIGINS=

# This API's own public address (only used for photos when Cloudinary is not set up)
PUBLIC_URL=http://localhost:4000

# "lax" when the API is on a subdomain of the website (api.saifitaxsolutions.site), recommended.
# "none" only if the API lives on a completely different domain (e.g. *.onrender.com).
COOKIE_SAMESITE=lax

# Cloudinary → Dashboard (API keys). Leave empty on your computer to save photos in server/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=saifi

# Vercel → Project → Settings → Git → Deploy Hooks → create one for "main" and paste it here.
# The website is rebuilt (published) this many minutes after the last change.
DEPLOY_HOOK_URL=
REBUILD_DELAY_MINUTES=2

# Largest photo accepted (MB)
MAX_UPLOAD_MB=25

# Number of proxies in front of the server (1 on Render/Railway/Vercel). Needed for correct rate limiting.
TRUST_PROXY=1
