# Website settings. Copy to ".env.local" on your computer.
# On Vercel: Project → Settings → Environment Variables, then redeploy.

# The website management API, no slash at the end, e.g. https://api.saifitaxsolutions.site
# Used by the admin panel at /admin, and by the build to read the published content.
# Leave empty on your computer: "/api" is then forwarded to http://localhost:4000.
VITE_API_URL=

# Optional: a different address for the build to read content from (normally leave empty).
# CONTENT_API_URL=

# Optional extras. Nothing is loaded when they are empty.
VITE_GA_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
