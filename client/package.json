{
  "name": "saifi-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "description": "Saifi Tax Solutions website (React, prerendered) and the website management panel at /admin.",
  "scripts": {
    "dev": "node scripts/fetch-content.mjs --soft && vite",
    "build": "node scripts/fetch-content.mjs && vite build --outDir dist/client && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview --outDir dist/site --port 4173",
    "verify": "node scripts/verify.mjs",
    "og": "node scripts/build-brand.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-router-dom": "^7.18.5",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "node-html-markdown": "^2.0.0",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.6"
  }
}
